{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"ignorePatterns": ["out/**", ".next/**", "docs/**", "pnpm-lock.yaml", "next-env.d.ts"],
	"overrides": [
		{
			"files": ["*.md"],
			"options": {
				"useTabs": false
			}
		}
	]
}
